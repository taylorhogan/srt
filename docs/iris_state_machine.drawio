      <mxGeometry x="990" y="1050" width="240" height="70" as="geometry" />
    </mxCell>

    <!-- _post_imaging_summary -->
    <mxCell id="end_summary" value="_post_imaging_summary()&#xa;read imaging_start.txt&#xa;scan FITS → post FWHM metrics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;" vertex="1" parent="1">
