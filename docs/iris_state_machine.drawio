      <mxGeometry x="990" y="310" width="240" height="90" as="geometry" />
    </mxCell>

    <!-- NOT parked branch -->
    <mxCell id="end_not_parked" value="Post: Iris NOT parked&#xa;roof stays open&#xa;power off mount + lights" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1280" y="330" width="200" height="70" as="geometry" />
