    <mxCell id="e_none_resolves" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#82b366;" edge="1" source="end_none" target="d_wait_none" parent="1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
