    <mxCell id="e_main_done_lbl" value="Yes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e_main_done">
      <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
    </mxCell>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- end.py (right column)                                          -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <!-- Group label -->
    <mxCell id="end_group_label" value="end.py  —  do_main()" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#3d3d3d;" vertex="1" parent="1">
      <mxGeometry x="990" y="70" width="280" height="30" as="geometry" />
    </mxCell>

    <!-- write safety.txt -->
    <mxCell id="end_safety" value='write safety.txt = "USER SAFE"' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="990" y="110" width="240" height="50" as="geometry" />
    </mxCell>

    <!-- device discovery -->
    <mxCell id="end_discover" value="Kasa device discovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="990" y="210" width="240" height="50" as="geometry" />
    </mxCell>

    <!-- is mount parked? -->
