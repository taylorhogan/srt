    <!-- ═══════════════════════════════════════════════════════════════ -->
    <mxCell id="e_return_end" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#9673a6;" edge="1" source="d_return" target="end_safety" parent="1">
      <mxGeometry relative="1" as="geometry">
