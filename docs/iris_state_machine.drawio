    <!-- Parked branch: power/lights on -->
    <mxCell id="end_lights" value="Post: Iris parked&#xa;power off mount&#xa;turn on roof motor + lights" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="990" y="450" width="240" height="70" as="geometry" />
