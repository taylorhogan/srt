    <mxCell id="e_end_vision_yes" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="end_vision" target="end_close_roof" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e_end_vision_yes_lbl" value="Yes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e_end_vision_yes">
      <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
