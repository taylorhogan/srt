    <!-- poll NONE: not yet → loop -->
    <mxCell id="e_main_wait" style="edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="d_wait_none" target="d_wait_none" parent="1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="740" y="1640" />
          <mxPoint x="740" y="1640" />
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="e_main_wait_lbl" value="No — sleep 60 s" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e_main_wait">
      <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
