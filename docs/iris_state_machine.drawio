    </mxCell>
    <mxCell id="e_none_resolves_lbl" value="ImagingState → NONE&#xa;unblocks scheduler poll" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e_none_resolves">
      <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
    </mxCell>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- LEGEND                                                          -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
