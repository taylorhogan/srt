#!/bin/bash
#
# sync_nina_targets_to_spark.bsh
# Syncs N.I.N.A Targets folder from Windows box to Spark (Linux).
#
# No arguments — source and destination are hardcoded.
#
# Source:      iriso@100.95.7.19:/cygdrive/c/Users/iriso/Documents/N.I.N.A/Targets
# Destination: /home/taylor/Desktop
#
# Cron (run at 6am daily) — add via `crontab -e`:
#   0 6 * * * /home/taylor/Documents/srt/scripts/sync_nina_targets_to_spark.bsh

SOURCE="iriso@100.95.7.19:/cygdrive/c/Users/iriso/Documents/N.I.N.A/Targets"
DESTINATION="/home/taylor/Desktop"

# --update (not --ignore-existing): Iris/<dso>/ processed outputs (stack_*,
# process_*, channels_*) are overwritten in place under the same filename on
# every reprocess. --ignore-existing skips them just because a stale local
# copy already exists by that name, silently dropping reprocessed results.
# --update instead compares mtimes and re-pulls when the remote is newer,
# while still skipping unchanged LIGHT/FLAT capture frames (unique names).
rsync -avz --update \
    --rsync-path="C:/Users/iriso/Documents/cwrsync_6.4.7_x64_free/bin/rsync" \
    "$SOURCE" \
    "$DESTINATION"

# The light-frame manifest (2026-10-19): a SHA-256 of every LIGHT frame in the
# copy just pulled, pushed back to iris-pc. `purge lights` there deletes a
# frame only when this manifest holds the same hash -- the proof that the
# Spark has it. No --delete above, so nothing removed on iris-pc is removed
# here. Hashes are cached; a normal morning hashes only the night's frames.
SRT=/home/taylor/Documents/srt
MANIFEST="$SRT/local/spark_light_manifest.json"
python3 "$SRT/scripts/spark_light_manifest.py" --root "$DESTINATION/Targets" --out "$MANIFEST" \
    && rsync -az \
        --rsync-path="C:/Users/iriso/Documents/cwrsync_6.4.7_x64_free/bin/rsync" \
        "$MANIFEST" \
        "iriso@100.95.7.19:/cygdrive/c/Users/iriso/Documents/development/srt/local/spark_light_manifest.json"
