# Python
__pycache__/
*.py[cod]

# Virtual environment
venv/
.venv/

# Private config
configs/config_private.py

# IDE
.idea/
.vscode/

# Runtime / data files
*.log
# ...except committed test fixtures: tests/replay/ holds SNAPSHOTS of runtime
# logs, frozen as regression data. The global *.log rule silently kept the
# first such fixture out of three consecutive commits -- local tests passed on
# the untracked file while CI failed on its absence, and only the deploy gate
# stopped the broken state reaching the observatory.
!tests/replay/*.log
safety.txt
imaging.txt
mode.txt
iris.log
cmd_history.json
local/
scratch/
my_instructions.json
my_calendar.json
sentry/roof_signatures/
sentry/library_spectrograms/
sentry/detected_spectrograms/
sentry/roof_audio/
sentry/roof_audio_kasa/

# Analysis images belong in local/analysis/, never the repo root. Root-anchored
# so tracked images in docs/, site/, base_images/ etc. are unaffected.
/*.png
/*.jpg
/*.jpeg
my_instruction_back.json
my_cal.back.json
scheduler_state.json
todo.txt
imaging_start.txt
imaging_job.txt

# Generated images / captures
saved_dso/
base_images/
cal.png
example_table.jpg
instructions.png
test_*.jpg
test_*.fits

# Sky-camera captures (scripts/probe_kasa_camera.py)
sky.jpg
*.h264
*.stream

# Personal / non-project files
*.scad
# ...but observatory hardware IS project work, so openscad/ is tracked.
!openscad/*.scad
# Except the personal pieces, which live there for tidiness but must stay out
# of a public repo. They were excluded deliberately; moving them into a tracked
# directory must not quietly publish them.
openscad/grace_*.scad

# macOS
.DS_Store
docs/M92_HR_Report.pdf
